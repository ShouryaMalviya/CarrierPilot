# ==============================================================================
# CareerPilot AI — Environment Configuration Template
# Copy this file to .env and adjust the values for your local environment.
# Never commit .env files containing actual secrets or keys to version control.
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & Authentication
# Replace with a cryptographically secure random secret (min 32 characters)
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./careerpilot.db
# Production target example (uncomment when using PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage Configuration (resumes stored outside web root)
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_MB=5

# Optional AI Provider Configuration (leave empty for deterministic fallback mode)
# Supported: local, openai, anthropic, gemini
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=15

# Optional Semantic Matching Configuration (false uses scikit-learn TF-IDF baseline)
ENABLE_SEMANTIC_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
